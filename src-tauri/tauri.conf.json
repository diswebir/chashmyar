{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChashmYar",
  "version": "2.4.4",
  "identifier": "com.chashmyar.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "چشم‌یار — محافظ چشم و پومودورو سخت‌گیرانه",
        "width": 1180,
        "height": 790,
        "minWidth": 1000,
        "minHeight": 680,
        "resizable": true,
        "center": true,
        "decorations": true,
        "transparent": false,
        "visible": true,
        "theme": "Light",
        "backgroundColor": "#eef2f8"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "ChashmYar",
    "copyright": "© 2026 ChashmYar",
    "category": "Utility",
    "shortDescription": "محافظ چشم، دیمر نمایشگر و پومودورو سخت‌گیرانه با گزارش فعالیت",
    "longDescription": "چشم‌یار با کنترل دمای رنگ سخت‌افزاری، کاهش روشنایی نرم‌افزاری و پومودوروی سخت‌گیرانه با قفل صفحه تمام‌صفحه به مراقبت از چشم و نظم عادت‌های کاری شما کمک می‌کند.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Farsi",
          "English"
        ],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "customLanguageFiles": {
          "Farsi": "installer/Farsi.nsh"
        }
      }
    }
  }
}
